#!/bin/bash

set -euo pipefail

readonly EXPECTED_TASK=:app:verifyProjectDirectory
readonly EXPECTED_MAX_WORKERS="${ANDROID_LAB_TEST_EXPECTED_WORKERS:-10}"
readonly PROJECT_DIRECTORY="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

[[ "$PWD" == "$PROJECT_DIRECTORY" ]]
[[ "$#" -eq 4 ]]
[[ "$1" == --no-daemon ]]
[[ "$2" == --max-workers ]]
[[ "$3" == "$EXPECTED_MAX_WORKERS" ]]
[[ "$4" == "$EXPECTED_TASK" ]]
